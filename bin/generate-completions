#!/usr/bin/env python
"""Generate shell completion scripts for doorstop CLI."""

import argparse
import os
import sys
from pathlib import Path


def generate_bash_completion() -> str:
    """Generate bash completion script."""
    commands = [
        "create", "delete", "add", "remove", "edit", "reorder",
        "link", "unlink", "clear", "review", "import", "export",
        "publish", "serve"
    ]
    
    script = """# Bash completion for doorstop
# Generated by bin/generate-completions

_doorstop() {
    local cur prev words cword
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    words="${COMP_WORDS[@]}"
    cword="${COMP_CWORD}"

    # Commands
    local commands="create delete add remove edit reorder link unlink clear review import export publish serve"
    
    # Global options
    local global_opts="-j --project --server --port -f --force -V --version -v --verbose -q --quiet -F --no-reformat -r --reorder -L --no-level-check -R --no-ref-check -C --no-child-check -Z --strict-child-check -S --no-suspect-check -W --no-review-check -s --skip -w --warn-all -e --error-all"
    
    # Complete commands
    if [[ ${cword} -eq 1 ]]; then
        COMPREPLY=($(compgen -W "${commands} ${global_opts}" -- "${cur}"))
        return 0
    fi
    
    # Complete options for commands
    case "${prev}" in
        -j|--project|--server|--port|-s|--skip)
            COMPREPLY=($(compgen -f -- "${cur}"))
            return 0
            ;;
    esac
    
    # Complete command-specific options
    local cmd="${COMP_WORDS[1]}"
    case "${cmd}" in
        create|add|edit|import|export|publish)
            COMPREPLY=($(compgen -W "${global_opts}" -- "${cur}"))
            ;;
        *)
            COMPREPLY=($(compgen -W "${global_opts}" -- "${cur}"))
            ;;
    esac
}

complete -F _doorstop doorstop
"""
    return script


def generate_zsh_completion() -> str:
    """Generate zsh completion script."""
    commands = [
        "create", "delete", "add", "remove", "edit", "reorder",
        "link", "unlink", "clear", "review", "import", "export",
        "publish", "serve"
    ]
    
    script = """#compdef doorstop
# Zsh completion for doorstop
# Generated by bin/generate-completions

_doorstop() {
    local -a commands global_opts
    
    commands=(
        'create:create a new document directory'
        'delete:delete a document directory'
        'add:create an item file in a document directory'
        'remove:remove an item file from a document directory'
        'edit:edit an item file'
        'reorder:reorder document levels'
        'link:link items together'
        'unlink:unlink items'
        'clear:clear item links'
        'review:review items'
        'import:import requirements from a file'
        'export:export requirements to a file'
        'publish:publish documents'
        'serve:serve documents via web interface'
    )
    
    global_opts=(
        '(-j --project)'{-j,--project}'[path to the root of the project]:path:_files'
        '(--server)'--server'[IP address or hostname for a running server]:host'
        '(--port)'--port'[use a custom port for the server]:port'
        '(-f --force)'{-f,--force}'[perform the action without the server]'
        '(-V --version)'{-V,--version}'[show version]'
        '(-v --verbose)'{-v,--verbose}'[enable verbose logging]'
        '(-q --quiet)'{-q,--quiet}'[only display errors and prompts]'
        '(-F --no-reformat)'{-F,--no-reformat}'[do not reformat item files during validation]'
        '(-r --reorder)'{-r,--reorder}'[reorder document levels during validation]'
        '(-L --no-level-check)'{-L,--no-level-check}'[do not validate document levels]'
        '(-R --no-ref-check)'{-R,--no-ref-check}'[do not validate external file references]'
        '(-C --no-child-check)'{-C,--no-child-check}'[do not validate child (reverse) links]'
        '(-Z --strict-child-check)'{-Z,--strict-child-check}'[require child (reverse) links from every document]'
        '(-S --no-suspect-check)'{-S,--no-suspect-check}'[do not check for suspect links]'
        '(-W --no-review-check)'{-W,--no-review-check}'[do not check item review status]'
        '(-s --skip)'{-s,--skip}'[skip a document during validation]:prefix'
        '(-w --warn-all)'{-w,--warn-all}'[display all info-level issues as warnings]'
        '(-e --error-all)'{-e,--error-all}'[display all warnings as errors]'
    )
    
    _arguments -C \\
        '*:: :->command' \\
        ${global_opts[@]} \\
        && return
    
    case $state in
        command)
            _describe 'command' commands
            ;;
    esac
}

_doorstop "$@"
"""
    return script


def generate_fish_completion() -> str:
    """Generate fish completion script."""
    commands = [
        "create", "delete", "add", "remove", "edit", "reorder",
        "link", "unlink", "clear", "review", "import", "export",
        "publish", "serve"
    ]
    
    script = """# Fish completion for doorstop
# Generated by bin/generate-completions

complete -c doorstop -f

# Commands
complete -c doorstop -n '__fish_use_subcommand' -a create -d 'create a new document directory'
complete -c doorstop -n '__fish_use_subcommand' -a delete -d 'delete a document directory'
complete -c doorstop -n '__fish_use_subcommand' -a add -d 'create an item file in a document directory'
complete -c doorstop -n '__fish_use_subcommand' -a remove -d 'remove an item file from a document directory'
complete -c doorstop -n '__fish_use_subcommand' -a edit -d 'edit an item file'
complete -c doorstop -n '__fish_use_subcommand' -a reorder -d 'reorder document levels'
complete -c doorstop -n '__fish_use_subcommand' -a link -d 'link items together'
complete -c doorstop -n '__fish_use_subcommand' -a unlink -d 'unlink items'
complete -c doorstop -n '__fish_use_subcommand' -a clear -d 'clear item links'
complete -c doorstop -n '__fish_use_subcommand' -a review -d 'review items'
complete -c doorstop -n '__fish_use_subcommand' -a import -d 'import requirements from a file'
complete -c doorstop -n '__fish_use_subcommand' -a export -d 'export requirements to a file'
complete -c doorstop -n '__fish_use_subcommand' -a publish -d 'publish documents'
complete -c doorstop -n '__fish_use_subcommand' -a serve -d 'serve documents via web interface'

# Global options
complete -c doorstop -s j -l project -d 'path to the root of the project' -r
complete -c doorstop -l server -d 'IP address or hostname for a running server' -r
complete -c doorstop -l port -d 'use a custom port for the server' -r
complete -c doorstop -s f -l force -d 'perform the action without the server'
complete -c doorstop -s V -l version -d 'show version'
complete -c doorstop -s v -l verbose -d 'enable verbose logging'
complete -c doorstop -s q -l quiet -d 'only display errors and prompts'
complete -c doorstop -s F -l no-reformat -d 'do not reformat item files during validation'
complete -c doorstop -s r -l reorder -d 'reorder document levels during validation'
complete -c doorstop -s L -l no-level-check -d 'do not validate document levels'
complete -c doorstop -s R -l no-ref-check -d 'do not validate external file references'
complete -c doorstop -s C -l no-child-check -d 'do not validate child (reverse) links'
complete -c doorstop -s Z -l strict-child-check -d 'require child (reverse) links from every document'
complete -c doorstop -s S -l no-suspect-check -d 'do not check for suspect links'
complete -c doorstop -s W -l no-review-check -d 'do not check item review status'
complete -c doorstop -s s -l skip -d 'skip a document during validation' -r
complete -c doorstop -s w -l warn-all -d 'display all info-level issues as warnings'
complete -c doorstop -s e -l error-all -d 'display all warnings as errors'
"""
    return script


def main() -> int:
    """Generate completion scripts."""
    parser = argparse.ArgumentParser(description="Generate shell completion scripts")
    parser.add_argument(
        "--shell",
        choices=["bash", "zsh", "fish", "all"],
        default="all",
        help="shell to generate completion for (default: all)",
    )
    parser.add_argument(
        "--output-dir",
        type=str,
        default="completions",
        help="output directory for completion scripts (default: completions)",
    )
    
    args = parser.parse_args()
    
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    
    shells = ["bash", "zsh", "fish"] if args.shell == "all" else [args.shell]
    
    for shell in shells:
        if shell == "bash":
            content = generate_bash_completion()
            output_file = output_dir / "doorstop.bash"
        elif shell == "zsh":
            content = generate_zsh_completion()
            output_file = output_dir / "_doorstop"
        elif shell == "fish":
            content = generate_fish_completion()
            output_file = output_dir / "doorstop.fish"
        else:
            continue
        
        output_file.write_text(content)
        print(f"Generated {shell} completion: {output_file}")
    
    return 0


if __name__ == "__main__":
    sys.exit(main())

